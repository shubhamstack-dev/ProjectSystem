# Copy to .env on the SERVER (same folder as docker-compose.prod.yml). Never commit .env.
DOMAIN=nexdprojectsystems.com

# Pick a long password with only letters and digits (no @ # : / so the URL needs no encoding).
MYSQL_PASSWORD=ChangeMeToALongRandomPassword123
# Same password again. If it contains special characters, URL-encode them here (@ -> %40, # -> %23).
MYSQL_PASSWORD_URLENC=ChangeMeToALongRandomPassword123

# Copy this file to .env and change the password.
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://root:root@123@localhost:3306/projectsystem
# Comma-separated list of front-end origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# ---- v1.3: sign-in and Microsoft Entra ID -------------------------------
# Signing key for this API's own session tokens. Set it, or restarting the
# API signs everybody out.
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_HOURS=12

# First run only: if there are no accounts at all one administrator is made.
# Leave the password unset and it is generated and printed to the API log once.
BOOTSTRAP_ADMIN_EMAIL=admin@aequm.in
# BOOTSTRAP_ADMIN_PASSWORD=

# Microsoft Entra ID. Leave blank to run on local accounts only.
# App registration needs:
#   Redirect URI (SPA)      http://localhost:5173/auth/callback
#   API permissions         User.Read.All (Application) with admin consent,
#                           for fetching users from the directory
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback

# Where an imported user is filed. Members are Aequm India staff; Guests are
# customers invited into the tenant as B2B.
ENTRA_MEMBER_ORG=Aequm India
ENTRA_MEMBER_ROLE=Team Member
ENTRA_GUEST_ORG=Customer
ENTRA_GUEST_ROLE=Customer Contact

# Sign-in without a prior import. Members yes, guests no: a customer who can
# create their own account is a customer who can reach another customer's work.
ENTRA_AUTO_PROVISION_MEMBERS=1
ENTRA_AUTO_PROVISION_GUESTS=0
